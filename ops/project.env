# Filled by new-project.sh. Every ops/*.sh script reads this file.
PROJECT=copycat
CHAIN=solana                      # robinhood | solana
KEYS_DIR="$HOME/.copycat-keys"      # this project's own wallets, never shared
RH_RPC=https://rpc.mainnet.chain.robinhood.com
SOL_RPC=https://api.mainnet-beta.solana.com   # replace with the keyed VPS route when available
WEB_DIR=web
